+    struct ao *ao = arg;
+    struct priv *p = ao->priv;
+    mp_thread_set_name("ao/coreaudio-idle");
+    mp_mutex_lock(&p->idle_mutex);
+    while (!p->idle_thread_stop) {
+        if (!p->idle_deadline) {
+            mp_cond_wait(&p->idle_cond, &p->idle_mutex);
+        } else if (mp_time_ns() < p->idle_deadline) {
+            mp_cond_timedwait_until(&p->idle_cond, &p->idle_mutex,
+                                    p->idle_deadline);
+        } else {
+            p->idle_deadline = 0;
+            MP_VERBOSE(ao, "Stopping audio unit due to idle timeout\n");
+            stop(ao);
+        }
+    }
+    mp_mutex_unlock(&p->idle_mutex);
+    MP_THREAD_RETURN();
+}
